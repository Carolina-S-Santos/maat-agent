# Copy this file to .env and fill in the API keys before running the LLM steps.
# Never commit the .env file.

OPENAI_API_KEY=
GEMINI_API_KEY=

# Maat implementations evaluated in the article (scripts/run_llm_experiment.py)
LLM_PROVIDERS=openai,gemini
OPENAI_MODEL=openai/gpt-4.1-mini
GEMINI_MODEL=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_REQUEST_DELAY_SECONDS=2.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=15.0

# Judge models used in the article (scripts/run_llm_judge_evaluation.py)
JUDGE_PROVIDERS=openai,gemini
OPENAI_JUDGE_MODEL=openai/gpt-4.1
GEMINI_JUDGE_MODEL=gemini/gemini-3.1-pro-preview
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=8000
JUDGE_REQUEST_DELAY_SECONDS=2.0
JUDGE_MAX_RETRIES=3
JUDGE_RETRY_BASE_DELAY_SECONDS=15.0

# Optional: limit the number of cases for a quick test run
# LLM_LIMIT=2
# JUDGE_LIMIT=2
